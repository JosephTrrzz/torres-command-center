# Browser-visible Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy alias supported by the current client helper
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare Pages Functions — keep these server-only
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-server-secret
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
PUBLIC_APP_URL=https://admin.example.com

# Transactional email — server-only. Verify the sending domain before enabling.
RESEND_API_KEY=replace-with-resend-server-secret
TRANSACTIONAL_EMAIL_FROM=Torres & Co. Technology <notifications@torrescotechnology.com>
TRANSACTIONAL_EMAIL_REPLY_TO=support@torrescotechnology.com
RESEND_WEBHOOK_SECRET=replace-with-resend-webhook-signing-secret

# Website lead intake — server-only webhook signature and destination mapping.
FORMSPREE_WEBHOOK_SECRET=replace-with-formspree-webhook-signing-secret
FORMSPREE_CLIENT_ID=replace-with-command-center-client-uuid
FORMSPREE_FORM_ID=replace-with-formspree-form-id

# Optional future provider secrets; configure only when that integration is implemented.
SQUARE_ACCESS_TOKEN=optional
SQUARE_WEBHOOK_SIGNATURE_KEY=optional
MAILCHIMP_API_KEY=optional
OPENAI_API_KEY=optional
CLOUDFLARE_API_TOKEN=optional
